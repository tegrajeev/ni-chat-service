    },
    {
     "name": "LocationConfidenceAddressLevel",
     "type": "Varchar(50)",
     "pk": false,
     "note": "Confidence at address line"
    }
   ],
   "notes": []
  },
  {
   "table": "HospitalDetails",
   "layer": "golden",
   "description": "One row per hospital/facility (HospitalId), with its primary NPI, address and county. Column name is spelled HosptitalName in the design.",
   "columns": [
    {
     "name": "HospitalId",
     "type": "Int",
     "pk": true
    },
    {
     "name": "HospitalNPI",
     "type": "Varchar(10)",
     "pk": false,
     "note": "aka primaryNPI_Id"
    },
    {
     "name": "HosptitalName",
     "type": "Varchar(100)",
     "pk": false
    },
    {
     "name": "PrimaryNPIName",
     "type": "Varchar(100)",
     "pk": false,
     "note": "can be same as HospitalName"
    },
    {
