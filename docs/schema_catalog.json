 "joinPaths": [
  {
   "name": "Providers in a network",
   "sql": "NetworkProviderMapping npm JOIN ProviderLocation pl ON pl.ProviderLocationId = npm.ProviderLocationId JOIN ProviderDetails pd ON pd.NPI = pl.NPI"
  },
  {
   "name": "Network owner (competitor)",
   "sql": "NetworkProviderMapping npm JOIN ParentOrganization po ON po.ParentOrganizationId = npm.ParentOrganizationId"
  },
  {
   "name": "Provider county / state",
   "sql": "ProviderLocation pl JOIN County c ON c.FIPS = pl.FIPS JOIN State s ON s.StateCode = c.StateCode"
  },
  {
   "name": "Provider specialty",
   "sql": "ProviderSpecialityMapping psm JOIN Speciality sp ON sp.SpecialityCode = psm.SpecialityCode  -- add psm.SpecialityFlag = 'Primary' to count each provider once"
  },
  {
   "name": "Hospitals in a network",
   "sql": "NetworkHospitalMapping nhm JOIN HospitalDetails hd ON hd.HospitalId = nhm.HospitalId LEFT JOIN HospitalScores hs ON hs.HospitalId = hd.HospitalId"
  },
  {
   "name": "Plans using a network",
   "sql": "PlanNetworkMapping pnm JOIN PlanDetails p ON p.BidId = pnm.BidId  -- use LEFT JOIN: not every BidId is in PlanDetails"
  },
  {
   "name": "Plan enrollment by county",
   "sql": "EnrollmentDetails ed JOIN PlanNetworkMapping pnm ON pnm.BidId = ed.BidId"
  },
  {
   "name": "Plan parent org / plan type / county",
   "sql": "PlanGeographyMapping pgm JOIN GeographyPlanFilters gpf ON gpf.GeographyPlanFiltersId = pgm.GeographyPlanFiltersId JOIN PlanType pt ON pt.PlanTypeId = gpf.PlanTypeId"
  },
  {
   "name": "Provider to physician group",
   "sql": "ProviderGroupAffiliation pga JOIN GroupDetails g ON g.GroupTIN = pga.GroupTIN"
  },
  {
   "name": "Provider to hospital",
   "sql": "ProviderHospitalAffiliation pha JOIN HospitalDetails hd ON hd.HospitalNPI = CAST(pha.HospitalNPI AS varchar(10))"
  },
  {
   "name": "Providers within X miles of a county",
   "sql": "MilesIndividual_30 m WHERE m.Isochrone_FIPS = '<fips>'"
  }
 ],
 "pitfalls": [
  "Count providers with COUNT(DISTINCT pl.NPI). A provider has several locations and several specialty rows, so COUNT(*) over-counts.",
  "Filter specialty with Speciality.HWAISpecialtyDescription (LIKE '%cardio%'), not by guessing SpecialityCode values.",
  "FIPS, NPI, ZipCode, BidId and GroupTIN are strings (varchar). Quote them: FIPS = '48113'.",
  "Score columns use -1 for 'not available'. Exclude -1 before AVG().",
  "Payer names live in ParentOrganization.ParentOrganizationName (e.g. 'Humana Inc.'). Match with LIKE '%humana%' unless the exact name is known.",
  "County names: County.CountyName may or may not include the word 'County'. Match with LIKE 'Dallas%' together with StateCode.",
  "ProviderHospitalAffiliation.HospitalNPI is Int but HospitalDetails.HospitalNPI is varchar. CAST when joining.",
  "PlanNetworkMapping has BidIds that are missing from PlanDetails. Use LEFT JOIN PlanDetails.",
  "The design lists HospitalDetails.HosptitalName (typo). Use whatever the live schema says; the service sends the live column list."
 ],
