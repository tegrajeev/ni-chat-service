     "type": "Varchar(100)",
     "pk": false,
     "note": "aka address_first_line"
    },
    {
     "name": "City",
     "type": "Varchar(50)",
     "pk": false
    },
    {
     "name": "ZipCode",
     "type": "Varchar(5)",
     "pk": false
    },
    {
     "name": "FIPS",
     "type": "Varchar(5)",
     "pk": false,
     "references": "County.FIPS"
    },
    {
     "name": "Latitude",
     "type": "Varchar(25)",
     "pk": false
    },
    {
     "name": "Longitude",
     "type": "Varchar(25)",
     "pk": false
    },
    {
     "name": "SpecialityCode",
     "type": "Varchar(5)",
     "pk": false,
     "references": "Speciality.SpecialityCode"
    },
    {
     "name": "AddressFlag",
     "type": "Varchar(25)",
     "pk": false
